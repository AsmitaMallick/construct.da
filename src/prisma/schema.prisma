generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum RuleCoverage {
    COUNTRY
    COUNCIL
    STATE
}

enum IngestionStatus {
    PENDING
    APPROVED
    REJECTED
}

enum FileStatus {
    PENDING
    PROCESSING
    PROCESSED
    FAILED
}

enum ProjectType {
    NEW_DWELLING

    HOME_EXTENSION
    SECOND_STOREY_ADDITION
    GARAGE_OR_CARPORT
    GRANNY_FLAT
    SWIMMING_POOL

    CHANGE_OF_USE

    DEMOLITION
    SIGNAGE
    RETAINING_WALL
}

enum ProjectReportStatus {
    PENDING
    COMPLETED
    PARTIAL
    FAILED
}

model RuleFiles {
    id       String          @id @default(uuid())
    name     String
    url      String
    coverage RuleCoverage
    status   IngestionStatus @default(PENDING)
    metadata Json?

    createdAt      DateTime        @default(now())
    ingestedAt     DateTime?
    fileEmbeddings FileEmbedding[]

    @@unique([name, url])
    @@index([name, id])
}

model Files {
    id        String     @id @default(uuid())
    name      String
    url       String
    metadata  Json?
    userId    String?
    projectId String?
    status    FileStatus @default(PENDING)

    createdAt      DateTime        @default(now())
    fileEmbeddings FileEmbedding[]
    User           User?           @relation(fields: [userId], references: [id])
    Project        Project?        @relation(fields: [projectId], references: [id])

    @@index([name, id])
    @@index([projectId])
}

model FileEmbedding {
    id String @id @default(uuid())

    fileId     String?
    ruleFileId String?
    projectId  String?
    chunkIndex Int
    pageNumber Int?

    title   String?
    content String  @db.Text

    source String?
    clause String?
    zone   String?
    topic  String?

    embedding     Unsupported("vector")
    search_vector Unsupported("tsvector")
    metadata      Json?

    createdAt DateTime @default(now())

    Files     Files?     @relation(fields: [fileId], references: [id])
    Project   Project?   @relation(fields: [projectId], references: [id])
    RuleFiles RuleFiles? @relation(fields: [ruleFileId], references: [id])

    @@index([fileId])
    @@index([clause])
    @@index([zone])
    @@index([topic])
    @@index([projectId])
    @@index([search_vector], type: Gin)
}

model User {
    id          String  @id @default(uuid())
    email       String  @unique
    name        String?
    clerkUserId String  @unique

    createdAt DateTime @default(now())

    Projects Project[]
    Files    Files[]

    @@index([email])
    @@index([clerkUserId])
}

model Project {
    id          String      @id @default(uuid())
    name        String
    description String?
    address     String
    type        ProjectType
    council     String
    userId      String
    metadata    Json?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    User           User            @relation(fields: [userId], references: [id])
    Files          Files[]
    fileEmbeddings FileEmbedding[]
    ProjectReport  ProjectReport[]

    @@index([name])
}

model ProjectReport {
    id               String            @id @default(uuid())
    projectId        String
    status           ProjectReportStatus @default(PENDING)
    score            Int?
    summary          String?
    executiveSummary String?
    findingsJson     Json?
    factsJson        Json?
    rulesJson        Json?
    rawOutputJson    Json?
    content          Json
    version          Int               @default(1)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    Project      Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
    findings     ProjectReportFinding[]
    checkResults ProjectReportCheckResult[]

    @@index([projectId])
    @@index([createdAt])
    @@unique([projectId, version])
}

model ProjectReportFinding {
    id             String         @id @default(uuid())
    projectReportId String
    key            String
    severity       String
    title          String
    detail         String
    evidence       Json?
    recommendation String?
    createdAt      DateTime       @default(now())

    projectReport ProjectReport @relation(fields: [projectReportId], references: [id], onDelete: Cascade)

    @@index([projectReportId])
    @@index([severity])
}

model ProjectReportCheckResult {
    id              String       @id @default(uuid())
    projectReportId String
    key             String
    category        String
    passed          Boolean
    severity        String
    message         String
    expected        Json?
    actual          Json?
    evidence        Json?
    createdAt       DateTime     @default(now())

    projectReport ProjectReport @relation(fields: [projectReportId], references: [id], onDelete: Cascade)

    @@index([projectReportId])
    @@index([category])
}
model Council {
  councilId        String            @id @map("council_id")
  councilName      String            @map("council_name")
  state            String
  officialWebsite  String?           @map("official_website")
  status           String?           @default("pending")
  documentsFound   Int               @default(0) @map("documents_found")
  lastProcessedAt  DateTime?         @map("last_processed_at")
  notes            String?
  documents        CouncilDocument[]
  @@map("councils")
}

model CouncilDocument {
  docId              String    @id @default(uuid()) @map("doc_id")
  councilId          String    @map("council_id")
  council            Council   @relation(fields: [councilId], references: [councilId])
  url                String
  domain             String?
  documentTitle      String?   @map("document_title")
  documentType       String?   @map("document_type")
  fileFormat         String?   @map("file_format")
  fileSizeBytes      BigInt?   @map("file_size_bytes")
  contentHash        String?   @map("content_hash")
  publicationDate    DateTime? @map("publication_date")
  isArchived         Boolean   @default(false) @map("is_archived")
  credibilityScore   Float?    @map("credibility_score")
  validationDecision String?   @map("validation_decision")
  validationReason   String?   @map("validation_reason")
  blobUrl            String?   @map("blob_url")
  textExtracted      Boolean   @default(false) @map("text_extracted")
  createdAt          DateTime  @default(now()) @map("created_at")
  @@map("council_documents")
}

model ValidationAuditLog {
  logId       Int      @id @default(autoincrement()) @map("log_id")
  runId       String?  @map("run_id")
  councilId   String?  @map("council_id")
  url         String?
  checkName   String?  @map("check_name")
  checkResult String?  @map("check_result")
  checkDetail String?  @map("check_detail")
  llmPrompt   String?  @map("llm_prompt")
  llmResponse String?  @map("llm_response")
  createdAt   DateTime @default(now()) @map("created_at")
  @@map("validation_audit_log")
}